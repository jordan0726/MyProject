{
  "name": "receiptcat-backend",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit --runInBand",
    "test:ci:clean": "jest --clearCache && rm -rf coverage reports/junit node_modules/.cache/jest cdk.out",
    "test:ci:fresh": "npm run test:ci:clean && npm run test:ci",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "package:lambdas": "node scripts/zip-lambdas.cjs"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "@types/uuid": "^9.0.8",
    "aws-cdk": "2.1022.0",
    "esbuild": "^0.25.9",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
    "@aws-sdk/client-dynamodb": "^3.868.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-sns": "^3.864.0",
    "@aws-sdk/client-textract": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@aws-sdk/util-dynamodb": "^3.896.0",
    "aws-cdk-lib": "2.206.0",
    "aws-lambda": "^1.0.7",
    "chrono-node": "^2.8.4",
    "constructs": "^10.0.0",
    "uuid": "^9.0.1"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
