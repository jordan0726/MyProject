# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Logs
logs                  # [NEW] Ignore generic logs folder from local dev
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*      

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
junit.xml
/cypress/screenshots
/reports

# next.js build outputs
/.next/
/out/
/dist                 # [NEW] Sometimes produced by Vite/rollup; ignore just in case
/dist-ssr             # [NEW] Vite SSR build output; not needed in Next.js. Since we change from vite to next, so added in case

# production
/build

# misc
.DS_Store
*.pem

# editor configs
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# env files
.env.local
.env.production.local
.env.development.local
.env.test.local

# vercel deployment
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cypress cache
.swc

# Test reports
junit.xml