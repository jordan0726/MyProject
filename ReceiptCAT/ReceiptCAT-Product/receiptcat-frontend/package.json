{
  "name": "receiptcat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "serve:static": "http-server out -p 3000 --silent --ext html",
    "test:unit": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit --runInBand",
    "test:ci:clean": "jest --clearCache && rm -rf coverage reports/junit .jest-cache .next node_modules/.cache .turbo",
    "test:ci:fresh": "npm run test:ci:clean && npm run test:ci",
    "test:e2e:run": "cypress run --reporter spec",
    "test:e2e:local": "start-server-and-test \"npm run serve:static\" http://localhost:3000 \"cypress run\"",
    "test:e2e:summary": "tsx run-e2e-summary.ts",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.4",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "antd": "^5.27.0",
    "cropperjs": "^1.6.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "next": "15.4.6",
    "oidc-client-ts": "^3.3.0",
    "react": "19.1.0",
    "react-cropper": "^2.3.3",
    "react-dom": "19.1.0",
    "react-masonry-css": "^1.0.16",
    "react-oidc-context": "^3.3.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.0.0",
    "@types/node": "22.7.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.4",
    "depcheck": "^1.4.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "next-router-mock": "^1.0.2",
    "start-server-and-test": "^2.0.13",
    "tailwindcss": "^4.1.12",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "~5.6.3"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
